    "#print prime numbers between to 2 to 20 using nested while\n",
    "num = 2\n",
    "\n",
    "while num <= 20:\n",
    "    is_prime = True\n",
    "    i = 2\n",
    "\n",
    "    while i < num:\n",
    "        if num % i == 0:\n",
    "            is_prime = False\n",
    "            break\n",
    "        i += 1\n",
    "\n",
    "    if is_prime:\n",
    "        print(num, end=\" \")\n",
    "\n",
    "    num += 1\n",
    "\n"
   ]
